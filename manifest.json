{
  "manifest_version": 3,
  "name": "Edge 快捷键卡片",
  "version": "1.10.0",
  "description": "页面内可收起/展开的 Edge 快捷键卡片：场景化提示、收起态 F8 键帽记录已试、Alt+O 打开官方说明、模糊搜索和 F2 逐键录入。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "展开/收起快捷键卡片 (Alt+Shift+K)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" }
    }
  }
}
