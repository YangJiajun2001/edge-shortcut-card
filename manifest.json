{
  "manifest_version": 3,
  "name": "Edge 快捷键卡片",
  "version": "1.1.0",
  "description": "独立小窗口中的 Edge 快捷键卡片：搜索、回车记录搜索次数、按频率排序。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开快捷键卡片 (Alt+Shift+K)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" }
    }
  }
}
